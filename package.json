{
  "name": "emibot",
  "version": "1.0.0",
  "description": "EmiBot is the first implementation of a future Discord-native AI assistant (EmiAgent). This repository contains the project's documentation, design notes, and the initial small-scope objectives for a minimal Discord bot.",
  "main": "src/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "register:commands": "node src/discord/register-commands.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dave-clouds/EmiBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dave-clouds/EmiBot/issues"
  },
  "homepage": "https://github.com/dave-clouds/EmiBot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
